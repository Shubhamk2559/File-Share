# --- Telegram (get API_ID / API_HASH at https://my.telegram.org, token from @BotFather)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=123456:ABC-your-bot-token

# Private channel used as file storage. Bot must be ADMIN there. ID starts with -100
DB_CHANNEL_ID=-1001234567890

# --- MongoDB (Atlas or self-hosted). With the docker "local-db" profile: mongodb://mongo:27017
MONGO_URI=mongodb+srv://user:pass@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=filesharebot

# Comma-separated Telegram user IDs allowed to use admin commands
ADMINS=111111111,222222222

# Comma-separated channel IDs (-100...) or @usernames. Leave empty to disable force-sub.
# Bot must be admin in each of them.
FORCE_SUB_CHANNELS=-1001111111111,@mychannel

# Seconds before delivered files are deleted (0 = never)
AUTO_DELETE_SECONDS=600

# Disable forwarding/saving of delivered files (true/false)
PROTECT_CONTENT=true

# Optional tuning
MAX_BATCH_SIZE=100
FLOOD_MAX_MESSAGES=6
FLOOD_WINDOW_SECONDS=10
FLOOD_BLOCK_SECONDS=60
